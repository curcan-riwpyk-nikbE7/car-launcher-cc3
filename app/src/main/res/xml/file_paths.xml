<?xml version="1.0" encoding="utf-8"?>
<!--
  Пути, которые лаунчер разрешает отдавать наружу.
  Нужен только кэш: туда скачивается APK обновления, и системный
  установщик читает его через FileProvider. Начиная с Android 7
  прямой путь к файлу передавать другим приложениям запрещено.
-->
<paths>
    <cache-path name="update_cache" path="." />
</paths>
