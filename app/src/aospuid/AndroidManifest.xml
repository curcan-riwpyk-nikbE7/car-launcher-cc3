<?xml version="1.0" encoding="utf-8"?>
<!--
  Сборка с расширенными правами для встраивания приложений в карточку.

  История вопроса. Сначала здесь стоял sharedUserId="android.uid.system",
  а APK подписывался ключом testkey — установка не проходила. Потом
  выяснилось, что testkey это подпись OTA-архива, а системные приложения
  прошивки подписаны platform: в образе /system публичный ключ platform
  встречается 190 раз против 34 у testkey.

  Пересобрали с platform — установка всё равно сорвалась.

  Значит производитель сгенерировал собственный ключ платформы, а не взял
  публичный из AOSP. Приватной части у нас нет и быть не может: в образе
  лежат только сертификаты, а подпись — операция односторонняя.

  Поэтому sharedUserId убран. Требование попасть в android.uid.system
  жёсткое: не совпала подпись — установка отклоняется целиком, без
  объяснений. Именно оно и блокировало установку, а не сами разрешения.

  Что остаётся. Права signature-уровня ниже запрошены и будут выданы,
  если подпись подойдёт; не подойдёт — приложение просто установится
  без них, и встраивание откатится на freeform-окно в границах карточки.
  Так же поступают другие лаунчеры с PIP: их «публичная» сборка не просит
  системный uid, поэтому ставится везде.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="android.uid.system">

    <!--
      ДОПОЛНЕНИЕ к истории выше: sharedUserId вернулся.

      Разбор чужого лаунчера, у которого окна работают на таких же ГУ,
      показал, что он просит ровно то же самое — android.uid.system —
      и подписан тем же публичным ключом platform, что и мы (c8a2e9bc).
      Значит подход был верным, а отказ установки вызван чем-то другим.

      Заодно выяснилось, каких прав нам не хватало: три разрешения ниже
      есть у него и не было у нас. ADD_TRUSTED_DISPLAY, судя по всему,
      ключевое — без него VirtualDisplay создаётся, но система не пускает
      в него чужие приложения. Ровно наш симптом: код отрабатывает,
      а карточка пустая.
    -->

    <!-- Виртуальный дисплей, которому система доверяет чужие окна -->
    <uses-permission android:name="android.permission.ADD_TRUSTED_DISPLAY"
        tools:ignore="ProtectedPermissions" />

    <!-- Передача касаний внутрь окна: без неё карта видна, но не реагирует на палец -->
    <uses-permission android:name="android.permission.INJECT_EVENTS"
        tools:ignore="ProtectedPermissions" />

    <!-- Запуск чужой активности на нашем дисплее -->
    <uses-permission android:name="android.permission.START_ANY_ACTIVITY"
        tools:ignore="ProtectedPermissions" />

    <!--
      Главное право. Без него ActivityOptions.setLaunchDisplayId для чужого
      приложения молча игнорируется, и вместо карты остаётся спидометр.
    -->
    <uses-permission android:name="android.permission.ACTIVITY_EMBEDDING"
        tools:ignore="ProtectedPermissions" />

    <!-- Держать окно чужого приложения внутри своей карточки -->
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW"
        tools:ignore="ProtectedPermissions" />

    <!-- Запуск на нужном дисплее без дублирования задач -->
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_STACKS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS"
        tools:ignore="ProtectedPermissions" />

    <!--
      force_resizable_activities: без него Яндекс Карты и YouTube верстают
      интерфейс как для полного экрана и половина уезжает за границы блока.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.CAPTURE_VIDEO_OUTPUT"
        tools:ignore="ProtectedPermissions" />
</manifest>
