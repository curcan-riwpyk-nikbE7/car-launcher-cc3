<?xml version="1.0" encoding="utf-8"?>
<!--
  Сборка под прошивки с тегом test-keys.

  AIDA64 на этом ГУ показывает:
      alps/full_k62v1_64_bsp/k62v1_64_bsp:8.1.0/O11019/...:user/test-keys
      Теги: test-keys

  Это ключ testkey из AOSP, а не platform — их часто путают, но подписи
  разные, и система сравнивает побайтно. Раньше системная версия
  подписывалась platform и не устанавливалась именно из-за этого.

  sharedUserId здесь намеренно НЕ указан. Он требует полного совпадения
  подписи с прошивкой, и при малейшем расхождении установка срывается
  целиком, вместо того чтобы просто не выдать часть прав. Права
  signature-уровня приходят и без него — Dudu работает ровно так же:
  показывает карту в блоке без рамки, не будучи системным пользователем.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Главное право. Без него ActivityOptions.setLaunchDisplayId для чужого
      приложения молча игнорируется, и вместо карты остаётся спидометр.
    -->
    <uses-permission android:name="android.permission.ACTIVITY_EMBEDDING"
        tools:ignore="ProtectedPermissions" />

    <!-- Держать окно чужого приложения внутри своей карточки -->
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW"
        tools:ignore="ProtectedPermissions" />

    <!-- Запуск на нужном дисплее без дублирования задач -->
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_STACKS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS"
        tools:ignore="ProtectedPermissions" />

    <!--
      force_resizable_activities: без него Яндекс Карты и YouTube верстают
      интерфейс как для полного экрана и половина уезжает за границы блока.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.CAPTURE_VIDEO_OUTPUT"
        tools:ignore="ProtectedPermissions" />
</manifest>
